{
  "manifest_version": 3,
  "name": "Insta Follower Tool",
  "version": "0.1.0",
  "description": "Açık profilin takip ettikleri ile takipçilerini karşılaştırır.",
  "permissions": ["activeTab"],
  "host_permissions": ["https://www.instagram.com/*"],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"]
    }
  ]
}
