{
  "manifest_version": 3,
  "name": "Insta Follower Tool",
  "version": "0.1.0",
  "description": "Açık profilin takip ettikleri ile takipçilerini karşılaştırır.",
  "permissions": [
    "activeTab",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_title": "Takip Analizi"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}